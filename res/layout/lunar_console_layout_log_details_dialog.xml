<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:background="@color/lunar_console_color_cell_background_dark" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@id/lunar_console_log_details_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/lunar_layout_console_entry_margin" android:src="@drawable/lunar_console_icon_log" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Message Details" style="@style/lunar_console_log_details_message_style" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0.0dp" android:layout_margin="@dimen/lunar_layout_console_stacktrace_margin" android:layout_weight="1.0">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@id/lunar_console_log_details_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Message" style="@style/lunar_console_log_details_message_style" />
            <TextView android:id="@id/lunar_console_log_details_stacktrace" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/lunar_layout_console_stacktrace_margin" style="@style/lunar_console_log_details_stacktrace_style" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
